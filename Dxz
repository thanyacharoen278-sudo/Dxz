local pages = {}

local function createPage(name)
	local page = Instance.new("Frame")
	page.Name = name
	page.Size = UDim2.new(1, 0, 0, 0)
	page.AutomaticSize = Enum.AutomaticSize.Y
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = content

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -30, 0, 36)
	label.Position = UDim2.new(0, 18, 0, 14)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 22
	label.TextColor3 = Color3.fromRGB(180, 220, 255)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = name
	label.Parent = page

	pages[name] = page
	return page
end

-- สร้างหน้าภาษาไทย
createPage("หน้าหลัก")
createPage("ทักษะ")
createPage("กระเป๋า")
createPage("ดันเจี้ยน")
createPage("ตั้งค่า")
createPage("เครดิต")

pages["หน้าหลัก"].Visible = true

local function openPage(name)
	for _, p in pairs(pages) do
		p.Visible = false
	end
	if pages[name] then
		pages[name].Visible = true
	end
end

local function addButton(text, pageName)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 36)
	b.BackgroundColor3 = Color3.fromRGB(25, 70, 160)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 15
	b.Text = text
	b.AutoButtonColor = false
	b.Parent = side
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.18), {
			BackgroundColor3 = Color3.fromRGB(0, 160, 255)
		}):Play()
	end)

	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.18), {
			BackgroundColor3 = Color3.fromRGB(25, 70, 160)
		}):Play()
	end)

	b.MouseButton1Click:Connect(function()
		openPage(pageName)
	end)
end

